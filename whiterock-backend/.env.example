# ── Django ──
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=your-super-secret-key-here
JWT_SIGNING_KEY=your-jwt-signing-key-here

# ── MongoDB ──
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/whiterock_crm?retryWrites=true&w=majority

# ── Redis (Railway provides this automatically) ──
REDIS_URL=redis://default:password@redis.railway.internal:6379/0

# ── CORS ──
CORS_ALLOWED_ORIGINS=https://whiterock-crm.up.railway.app,https://your-nextjs-domain.vercel.app

# ── Host ──
ALLOWED_HOSTS=whiterock-backend.up.railway.app,localhost
