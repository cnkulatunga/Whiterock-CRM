# ── Django ────────────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=False

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_USERNAME=whiterock
MONGO_PASSWORD=change-me-strong-password
MONGODB_URI=mongodb://${MONGO_USERNAME}:${MONGO_PASSWORD}@mongodb:27017
MONGODB_NAME=whiterock_crm

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-strong-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ── Domain (production) ───────────────────────────────────────────────────────
# Your production domain, e.g. crm.whiterock.com.au
DOMAIN=your-domain-here
# Email for Let's Encrypt certificate notifications
ACME_EMAIL=your-email@example.com

# ── Docker images ─────────────────────────────────────────────────────────────
# Your Docker registry prefix, e.g. ghcr.io/yourusername or docker.io/yourusername
DOCKER_REGISTRY=ghcr.io/thanushikaabeykoon
IMAGE_TAG=latest

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set automatically in docker-compose.prod.yml from DOMAIN — override only if needed
# CORS_ALLOWED_ORIGINS=https://your-domain-here

# ── Gmail API ─────────────────────────────────────────────────────────────────
# Get these from Google Cloud Console → APIs & Services → Credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_SENDER_EMAIL=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Set automatically in docker-compose.prod.yml from DOMAIN — override only if needed
# NEXT_PUBLIC_API_URL=https://your-domain-here
